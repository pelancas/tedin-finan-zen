# URL do túnel Cloudflare do orienta-dd (sem barra no final).
# ATENÇÃO: túneis "trycloudflare.com" são efêmeros — a URL muda toda vez que o
# cloudflared reinicia, a menos que seja um túnel nomeado com hostname fixo.
VITE_ORIENTA_API_URL=https://processor-tanks-blend-teach.trycloudflare.com

# Mesmo valor de ORIENTA_API_TOKEN configurado no orienta-dd (config.py).
# Fica exposto no bundle JS público do site — ver aviso no README/CLAUDE.md.
VITE_ORIENTA_API_TOKEN=
